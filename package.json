{
  "name": "bia-platform",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --parallel",
    "start": "npm run start --workspaces --parallel",
    "dev:frontend": "npm run dev --workspace=@bia/frontend",
    "dev:backend": "npm run dev --workspace=@bia/backend",
    "build:frontend": "npm run build --workspace=@bia/frontend",
    "build:backend": "npm run build --workspace=@bia/backend",
    "build": "npm run build:frontend",
    "start:frontend": "npm run start --workspace=@bia/frontend",
    "start:backend": "npm run start --workspace=@bia/backend",
    "typecheck:frontend": "npm run typecheck --workspace=@bia/frontend",
    "typecheck:backend": "npm run typecheck --workspace=@bia/backend",
    "typecheck": "npm run typecheck:frontend & npm run typecheck:backend",
    "test:barber": "npm run test:barber --workspace=@bia/backend",
    "test:academy": "npm run test:academy --workspace=@bia/backend",
    "test:whatsapp": "npm run test:whatsapp --workspace=@bia/backend",
    "test:ai": "npm run test:ai --workspace=@bia/backend",
    "test:all": "npm run test:barber & npm run test:academy & npm run test:whatsapp & npm run test:ai",
    "prisma:generate": "npm run generate --workspace=@bia/database",
    "prisma:push": "npm run db:push --workspace=@bia/database"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
